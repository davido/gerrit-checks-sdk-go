{
  "openapi": "3.1.0",
  "info": {"title": "Gerrit Checks Plugin REST API", "version": "3.15.0-SNAPSHOT", "description": "REST endpoints contributed by the checks plugin. Paths, parameters and payload schemas are generated statically from the plugin's REST bindings; human-authored summaries, descriptions and examples are mined from the plugin's rest-api*.md and merged in at build time."},
  "servers": [{"url": "https://{host}/a", "description": "Authenticated endpoints (HTTP basic auth).", "variables": {"host": {"default": "gerrit-review.googlesource.com"}}}, {"url": "https://{host}", "description": "Anonymously accessible endpoints.", "variables": {"host": {"default": "gerrit-review.googlesource.com"}}}],
  "paths": {
    "/changes/{change-id}/revisions/{revision-id}/checks": {"get": {"operationId": "getChangesChangeIdRevisionsRevisionIdChecks", "summary": "List Checks", "description": "Retrieves all checks for a given revision and change.", "tags": ["changes"], "parameters": [{"name": "change-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "revision-id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"default": {"description": "Response", "content": {"application/json": {"schema": {}, "x-gerrit-response-unresolved": true, "example": [{"repository": "test-repo", "change_number": 1, "patch_set_id": 1, "checker_uuid": "test:my-checker", "state": "NOT_STARTED", "url": "https://foo.corp.com/test-checker/results/123", "created": "2019-01-31 09:59:32.126000000", "updated": "2019-01-31 09:59:32.126000000"}, {"repository": "test-repo", "change_number": 1, "patch_set_id": 1, "checker_uuid": "foo:foo-checker", "state": "FINISHED", "created": "2019-01-31 09:59:32.126000000", "updated": "2019-01-31 09:59:32.126000000"}]}}}}}, "post": {"operationId": "postChangesChangeIdRevisionsRevisionIdChecks", "summary": "Create Check", "description": "Creates a new check.", "tags": ["changes"], "parameters": [{"name": "change-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "revision-id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckInput"}, "example": {"checker_uuid": "test:my-checker", "state": "RUNNING", "url": "https://foo.corp.com/test-checker/results/123", "started": "2019-01-31 09:59:32.126000000"}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/CheckInput"}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckInfo"}, "example": {"repository": "test-repo", "change_number": 1, "patch_set_id": 1, "checker_uuid": "test:my-checker", "state": "RUNNING", "url": "https://foo.corp.com/test-checker/results/123", "started": "2019-01-31 09:59:32.126000000", "created": "2019-01-31 09:59:32.126000000", "updated": "2019-01-31 09:59:32.126000000"}}}}}}},
    "/changes/{change-id}/revisions/{revision-id}/checks/{check-id}": {"get": {"operationId": "getChangesChangeIdRevisionsRevisionIdChecksCheckId", "summary": "Get Check", "description": "Retrieves a check.", "tags": ["changes"], "parameters": [{"name": "change-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "revision-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "check-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "O", "in": "query", "schema": {"type": "string"}}, {"name": "o", "in": "query", "schema": {"type": "array", "items": {"type": "string"}}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckInfo"}, "example": {"repository": "test-repo", "change_number": 1, "patch_set_id": 1, "checker_uuid": "test:my-checker", "state": "NOT_STARTED", "url": "https://foo.corp.com/test-checker/results/123", "created": "2019-01-31 09:59:32.126000000", "updated": "2019-01-31 09:59:32.126000000"}}}}}}, "post": {"operationId": "postChangesChangeIdRevisionsRevisionIdChecksCheckId", "summary": "Update Check", "description": "Updates a check. The semantics are the same as for CreateCheck.", "tags": ["changes"], "parameters": [{"name": "change-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "revision-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "check-id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckInput"}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/CheckInput"}}}}, "responses": {"default": {"description": "Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckInfo"}}}}}}},
    "/changes/{change-id}/revisions/{revision-id}/checks/{check-id}/rerun": {"post": {"operationId": "postChangesChangeIdRevisionsRevisionIdChecksCheckIdRerun", "summary": "Rerun Check", "description": "Reruns a check. As response the CheckInfo entity is returned that describes the created check.", "tags": ["changes"], "parameters": [{"name": "change-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "revision-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "check-id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RerunInput"}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/RerunInput"}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckInfo"}}}}}}},
    "/plugins/checks/checkers": {"get": {"operationId": "getPluginsChecksCheckers", "summary": "List Checkers", "description": "Retrieves all checkers.", "tags": ["checkers"], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/CheckerInfo"}}, "example": [{"uuid": "test:my-checker", "name": "MyChecker", "repository": "examples/Foo", "blocking": [], "description": "A simple checker.", "created": "2019-01-31 09:59:32.126000000"}]}}}}}, "post": {"operationId": "postPluginsChecksCheckers", "summary": "Create Checker", "description": "Creates a new checker.", "tags": ["checkers"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckerInput"}, "example": {"uuid": "test:my-checker", "name": "MyChecker", "description": "A simple checker.", "repository": "examples/Foo"}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/CheckerInput"}}}}, "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckerInfo"}, "example": {"uuid": "test:my-checker", "name": "MyChecker", "description": "A simple checker.", "repository": "examples/Foo", "created": "2019-01-31 09:59:32.126000000", "updated": "2019-01-31 09:59:32.126000000"}}}}}}},
    "/plugins/checks/checkers/{checker-id}": {"get": {"operationId": "getPluginsChecksCheckersCheckerId", "summary": "Get Checker", "description": "Retrieves a checker.", "tags": ["checkers"], "parameters": [{"name": "checker-id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckerInfo"}, "example": {"uuid": "test:my-checker", "name": "MyChecker", "repository": "examples/Foo", "blocking": [], "description": "A simple checker.", "created": "2019-01-31 09:59:32.126000000"}}}}}}, "post": {"operationId": "postPluginsChecksCheckersCheckerId", "summary": "Update Checker", "description": "Updates a checker.", "tags": ["checkers"], "parameters": [{"name": "checker-id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckerInput"}, "example": {"description": "A simple checker."}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/CheckerInput"}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckerInfo"}, "example": {"uuid": "test:my-checker", "name": "MyChecker", "description": "A simple checker.", "repository": "examples/Foo", "status": "ENABLED", "created": "2019-01-31 09:59:32.126000000", "updated": "2019-02-01 07:23:44.158000000"}}}}}}}
  },
  "components": {
    "schemas": {
      "BlockingCondition": {"type": "string", "enum": ["STATE_NOT_PASSING"]},
      "CheckInfo": {"type": "object", "properties": {"repository": {"type": "string", "description": "The repository name that this check applies to."}, "change_number": {"type": "integer", "description": "The change number that this check applies to."}, "patch_set_id": {"type": "integer", "description": "The patch set that this check applies to."}, "checker_uuid": {"type": "string", "description": "The UUID of the checker that reported this check."}, "state": {"$ref": "#/components/schemas/CheckState", "description": "The state as string-serialized form of CheckState"}, "message": {"type": "string", "description": "Short message explaining the check state. Size limit is 10k by default, configured via plugin.checks.messageSizeLimit."}, "url": {"type": "string", "description": "A fully-qualified URL pointing to the result of the check on the checker's infrastructure."}, "started": {"type": "string", "format": "gerrit-timestamp", "description": "The timestamp of when the check started processing."}, "finished": {"type": "string", "format": "gerrit-timestamp", "description": "The timestamp of when the check finished processing."}, "created": {"type": "string", "format": "gerrit-timestamp", "description": "The timestamp of when the check was created."}, "updated": {"type": "string", "format": "gerrit-timestamp", "description": "The timestamp of when the check was last updated."}, "checker_name": {"type": "string", "description": "The name of the checker that produced this check.<br />Only set if checker details are requested."}, "checker_status": {"$ref": "#/components/schemas/CheckerStatus", "description": "The status of the checker that produced this check.<br />Only set if checker details are requested."}, "blocking": {"type": "array", "items": {"$ref": "#/components/schemas/BlockingCondition"}, "description": "Set of blocking conditions that apply to this checker.<br />Only set if checker details are requested."}, "submit_impact": {"$ref": "#/components/schemas/CheckSubmitImpactInfo", "description": "The CheckSubmitImpactInfo that describes a check's impact on the submission of the change.<br />Only set if checker details are requested."}, "checker_description": {"type": "string", "description": "The description of the checker that reported this check."}}},
      "CheckInput": {"type": "object", "properties": {"checker_uuid": {"type": "string", "description": "The UUID of the checker. Must be specified for check creation. Optional only if updating a check and referencing the checker using the UUID in the URL."}, "state": {"$ref": "#/components/schemas/CheckState", "description": "The state as string-serialized form of CheckState"}, "message": {"type": "string", "description": "Short message explaining the check state."}, "url": {"type": "string", "description": "A fully-qualified URL pointing to the result of the check on the checker's infrastructure."}, "started": {"type": "string", "format": "gerrit-timestamp", "description": "The timestamp of when the check started processing."}, "finished": {"type": "string", "format": "gerrit-timestamp", "description": "The timestamp of when the check finished processing."}, "notify": {"$ref": "#/components/schemas/NotifyHandling", "description": "Notify handling that defines to whom email notifications should be sent when the combined check state changes due to posting this check. Allowed values are NONE, OWNER, OWNER_REVIEWERS and ALL."}, "notify_details": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/NotifyInfo"}, "description": "Additional information about whom to notify when the combined check state changes due to posting this check as a map of recipient type to NotifyInfo entity. Regardless of this setting there are no email notifications for posting checks on non-current patch sets."}}},
      "CheckState": {"type": "string", "enum": ["FAILED", "NOT_STARTED", "SCHEDULED", "RUNNING", "SUCCESSFUL", "NOT_RELEVANT"]},
      "CheckSubmitImpactInfo": {"type": "object", "properties": {"required": {"type": "boolean", "description": "When set, that check blocks change submission until it's in appropriate non-blocking state."}}},
      "CheckerInfo": {"type": "object", "properties": {"uuid": {"type": "string", "description": "The UUID of the checker."}, "name": {"type": "string", "description": "The name of the checker, may not be unique."}, "description": {"type": "string", "description": "The description of the checker."}, "url": {"type": "string", "description": "The URL of the checker."}, "repository": {"type": "string", "description": "The (exact) name of the repository for which the checker applies."}, "status": {"$ref": "#/components/schemas/CheckerStatus", "description": "The status of the checker; one of ENABLED or DISABLED."}, "blocking": {"type": "array", "items": {"$ref": "#/components/schemas/BlockingCondition"}, "description": "A list of conditions that describe when the checker should block change submission."}, "query": {"type": "string", "description": "A query that limits changes for which the checker is relevant."}, "created": {"type": "string", "format": "gerrit-timestamp", "description": "The timestamp of when the checker was created."}, "updated": {"type": "string", "format": "gerrit-timestamp", "description": "The timestamp of when the checker was last updated."}}},
      "CheckerInput": {"type": "object", "properties": {"uuid": {"type": "string", "description": "The UUID of the checker."}, "name": {"type": "string", "description": "The name of the checker."}, "description": {"type": "string", "description": "The description of the checker."}, "url": {"type": "string", "description": "The URL of the checker."}, "repository": {"type": "string", "description": "The (exact) name of the repository for which the checker applies."}, "status": {"$ref": "#/components/schemas/CheckerStatus", "description": "The status of the checker; one of ENABLED or DISABLED."}, "blocking": {"type": "array", "items": {"$ref": "#/components/schemas/BlockingCondition"}, "description": "A list of conditions that describe when the checker should block change submission."}, "query": {"type": "string", "description": "A query that limits changes for which the checker is relevant."}}},
      "CheckerStatus": {"type": "string", "enum": ["ENABLED", "DISABLED"]},
      "NotifyHandling": {"type": "string", "enum": ["NONE", "OWNER", "OWNER_REVIEWERS", "ALL"]},
      "NotifyInfo": {"type": "object", "properties": {"accounts": {"type": "array", "items": {"type": "string"}, "description": "A list of account IDs that identify the accounts that should be notified."}}},
      "RerunInput": {"type": "object", "properties": {"notify": {"$ref": "#/components/schemas/NotifyHandling", "description": "Notify handling that defines to whom email notifications should be sent when the combined check state changes due to rerunning this check. Allowed values are NONE, OWNER, OWNER_REVIEWERS and ALL. If not set, the default is OWNER."}, "notify_details": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/NotifyInfo"}, "description": "Additional information about whom to notify when the combined check state changes due to rerunning this check as a map of recipient type to NotifyInfo entity. Regardless of this setting there are no email notifications for rerunning checks on non-current patch sets."}}}
    },
    "securitySchemes": {"basicAuth": {"type": "http", "scheme": "basic", "description": "HTTP basic auth with a username and a generated HTTP password."}}
  },
  "security": [{"basicAuth": []}],
  "tags": [{"name": "changes", "description": "Checks reported on change revisions."}, {"name": "checkers", "description": "Checker administration."}]
}
