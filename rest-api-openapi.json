{
  "openapi": "3.1.0",
  "info": {"title": "Gerrit Checks Plugin REST API", "version": "3.15.0-SNAPSHOT", "description": "REST endpoints contributed by the checks plugin. Paths, parameters and payload schemas are generated statically from the plugin's REST bindings; human-authored summaries, descriptions and examples are mined from the plugin's rest-api*.md and merged in at build time."},
  "servers": [{"url": "https://{host}/a", "description": "Authenticated endpoints (HTTP basic auth).", "variables": {"host": {"default": "gerrit-review.googlesource.com"}}}, {"url": "https://{host}", "description": "Anonymously accessible endpoints.", "variables": {"host": {"default": "gerrit-review.googlesource.com"}}}],
  "paths": {
    "/changes/{change-id}/revisions/{revision-id}/checks": {"get": {"operationId": "getChangesChangeIdRevisionsRevisionIdChecks", "summary": "List Checks", "description": "Retrieves all checks for a given revision and change.", "tags": ["changes"], "parameters": [{"name": "change-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "revision-id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"default": {"description": "Response", "content": {"application/json": {"schema": {"type": "object"}, "example": [{"repository": "test-repo", "change_number": 1, "patch_set_id": 1, "checker_uuid": "test:my-checker", "state": "NOT_STARTED", "url": "https://foo.corp.com/test-checker/results/123", "created": "2019-01-31 09:59:32.126000000", "updated": "2019-01-31 09:59:32.126000000"}, {"repository": "test-repo", "change_number": 1, "patch_set_id": 1, "checker_uuid": "foo:foo-checker", "state": "FINISHED", "created": "2019-01-31 09:59:32.126000000", "updated": "2019-01-31 09:59:32.126000000"}]}}}}}, "post": {"operationId": "postChangesChangeIdRevisionsRevisionIdChecks", "summary": "Create Check", "description": "Creates a new check.", "tags": ["changes"], "parameters": [{"name": "change-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "revision-id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckInput"}, "example": {"checker_uuid": "test:my-checker", "state": "RUNNING", "url": "https://foo.corp.com/test-checker/results/123", "started": "2019-01-31 09:59:32.126000000"}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/CheckInput"}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckInfo"}, "example": {"repository": "test-repo", "change_number": 1, "patch_set_id": 1, "checker_uuid": "test:my-checker", "state": "RUNNING", "url": "https://foo.corp.com/test-checker/results/123", "started": "2019-01-31 09:59:32.126000000", "created": "2019-01-31 09:59:32.126000000", "updated": "2019-01-31 09:59:32.126000000"}}}}}}},
    "/changes/{change-id}/revisions/{revision-id}/checks/{check-id}": {"get": {"operationId": "getChangesChangeIdRevisionsRevisionIdChecksCheckId", "summary": "Get Check", "description": "Retrieves a check.", "tags": ["changes"], "parameters": [{"name": "change-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "revision-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "check-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "O", "in": "query", "schema": {"type": "string"}}, {"name": "o", "in": "query", "schema": {"type": "array", "items": {"type": "string"}}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckInfo"}, "example": {"repository": "test-repo", "change_number": 1, "patch_set_id": 1, "checker_uuid": "test:my-checker", "state": "NOT_STARTED", "url": "https://foo.corp.com/test-checker/results/123", "created": "2019-01-31 09:59:32.126000000", "updated": "2019-01-31 09:59:32.126000000"}}}}}}, "post": {"operationId": "postChangesChangeIdRevisionsRevisionIdChecksCheckId", "summary": "Update Check", "description": "Updates a check. The semantics are the same as for [CreateCheck](#create-check).", "tags": ["changes"], "parameters": [{"name": "change-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "revision-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "check-id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckInput"}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/CheckInput"}}}}, "responses": {"default": {"description": "Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckInfo"}}}}}}},
    "/changes/{change-id}/revisions/{revision-id}/checks/{check-id}/rerun": {"post": {"operationId": "postChangesChangeIdRevisionsRevisionIdChecksCheckIdRerun", "summary": "Rerun Check", "description": "Reruns a check. As response the [CheckInfo](#check-info) entity is returned that describes the created check.", "tags": ["changes"], "parameters": [{"name": "change-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "revision-id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "check-id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RerunInput"}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/RerunInput"}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckInfo"}}}}}}},
    "/plugins/checks/checkers": {"get": {"operationId": "getPluginsChecksCheckers", "tags": ["checkers"], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/CheckerInfo"}}}}}}}, "post": {"operationId": "postPluginsChecksCheckers", "summary": "Create Checker", "description": "Creates a new checker.", "tags": ["checkers"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckerInput"}, "example": {"uuid": "test:my-checker", "name": "MyChecker", "description": "A simple checker.", "repository": "examples/Foo"}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/CheckerInput"}}}}, "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckerInfo"}, "example": {"uuid": "test:my-checker", "name": "MyChecker", "description": "A simple checker.", "repository": "examples/Foo", "created": "2019-01-31 09:59:32.126000000", "updated": "2019-01-31 09:59:32.126000000"}}}}}}},
    "/plugins/checks/checkers/{checker-id}": {"get": {"operationId": "getPluginsChecksCheckersCheckerId", "summary": "Get Checker", "description": "Retrieves a checker.", "tags": ["checkers"], "parameters": [{"name": "checker-id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckerInfo"}, "example": {"uuid": "test:my-checker", "name": "MyChecker", "repository": "examples/Foo", "blocking": [], "description": "A simple checker.", "created": "2019-01-31 09:59:32.126000000"}}}}}}, "post": {"operationId": "postPluginsChecksCheckersCheckerId", "summary": "Update Checker", "description": "Updates a checker.", "tags": ["checkers"], "parameters": [{"name": "checker-id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckerInput"}, "example": {"description": "A simple checker."}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/CheckerInput"}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckerInfo"}, "example": {"uuid": "test:my-checker", "name": "MyChecker", "description": "A simple checker.", "repository": "examples/Foo", "status": "ENABLED", "created": "2019-01-31 09:59:32.126000000", "updated": "2019-02-01 07:23:44.158000000"}}}}}}}
  },
  "components": {
    "schemas": {
      "BlockingCondition": {"type": "string", "enum": ["STATE_NOT_PASSING"]},
      "CheckInfo": {"type": "object", "properties": {"repository": {"type": "string"}, "change_number": {"type": "integer"}, "patch_set_id": {"type": "integer"}, "checker_uuid": {"type": "string"}, "state": {"$ref": "#/components/schemas/CheckState"}, "message": {"type": "string"}, "url": {"type": "string"}, "started": {"type": "string", "format": "gerrit-timestamp"}, "finished": {"type": "string", "format": "gerrit-timestamp"}, "created": {"type": "string", "format": "gerrit-timestamp"}, "updated": {"type": "string", "format": "gerrit-timestamp"}, "checker_name": {"type": "string"}, "checker_status": {"$ref": "#/components/schemas/CheckerStatus"}, "blocking": {"type": "array", "items": {"$ref": "#/components/schemas/BlockingCondition"}}, "submit_impact": {"$ref": "#/components/schemas/CheckSubmitImpactInfo"}, "checker_description": {"type": "string"}}},
      "CheckInput": {"type": "object", "properties": {"checker_uuid": {"type": "string"}, "state": {"$ref": "#/components/schemas/CheckState"}, "message": {"type": "string"}, "url": {"type": "string"}, "started": {"type": "string", "format": "gerrit-timestamp"}, "finished": {"type": "string", "format": "gerrit-timestamp"}, "notify": {"$ref": "#/components/schemas/NotifyHandling"}, "notify_details": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/NotifyInfo"}}}},
      "CheckState": {"type": "string", "enum": ["FAILED", "NOT_STARTED", "SCHEDULED", "RUNNING", "SUCCESSFUL", "NOT_RELEVANT"]},
      "CheckSubmitImpactInfo": {"type": "object", "properties": {"required": {"type": "boolean"}}},
      "CheckerInfo": {"type": "object", "properties": {"uuid": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "url": {"type": "string"}, "repository": {"type": "string"}, "status": {"$ref": "#/components/schemas/CheckerStatus"}, "blocking": {"type": "array", "items": {"$ref": "#/components/schemas/BlockingCondition"}}, "query": {"type": "string"}, "created": {"type": "string", "format": "gerrit-timestamp"}, "updated": {"type": "string", "format": "gerrit-timestamp"}}},
      "CheckerInput": {"type": "object", "properties": {"uuid": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "url": {"type": "string"}, "repository": {"type": "string"}, "status": {"$ref": "#/components/schemas/CheckerStatus"}, "blocking": {"type": "array", "items": {"$ref": "#/components/schemas/BlockingCondition"}}, "query": {"type": "string"}}},
      "CheckerStatus": {"type": "string", "enum": ["ENABLED", "DISABLED"]},
      "NotifyHandling": {"type": "string", "enum": ["NONE", "OWNER", "OWNER_REVIEWERS", "ALL"]},
      "NotifyInfo": {"type": "object", "properties": {"accounts": {"type": "array", "items": {"type": "string"}}}},
      "RerunInput": {"type": "object", "properties": {"notify": {"$ref": "#/components/schemas/NotifyHandling"}, "notify_details": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/NotifyInfo"}}}}
    },
    "securitySchemes": {"basicAuth": {"type": "http", "scheme": "basic", "description": "HTTP basic auth with a username and a generated HTTP password."}}
  },
  "security": [{"basicAuth": []}],
  "tags": [{"name": "changes", "description": "Checks reported on change revisions."}, {"name": "checkers", "description": "Checker administration."}]
}
